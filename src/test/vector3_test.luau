local Vector3 = require("@Vector3")
local testing = zune.testing
local expect = testing.expect

local function near(a, b, epsilon)
	epsilon = epsilon or 1e-5
	return math.abs(a - b) <= epsilon
end

local function expectVecNear(v, x, y, z, epsilon)
	expect(near(v.X, x, epsilon)).toBeTruthy()
	expect(near(v.Y, y, epsilon)).toBeTruthy()
	expect(near(v.Z, z, epsilon)).toBeTruthy()
end

testing.describe("Vector3", function()
	testing.test("Creation", function()
		local v = Vector3.new(1, 2, 3)
		expect(v.X).toBe(1)
		expect(v.Y).toBe(2)
		expect(v.Z).toBe(3)
	end)

	testing.test("Creation defaults to zero", function()
		local v = Vector3.new()
		expect(v.X).toBe(0)
		expect(v.Y).toBe(0)
		expect(v.Z).toBe(0)
	end)

	testing.test("Magnitude", function()
		local v = Vector3.new(3, 4, 0)
		expect(v:Magnitude()).toBe(5)
	end)

	testing.test("MagnitudeSquared", function()
		local v = Vector3.new(3, 4, 12)
		expect(v:MagnitudeSquared()).toBe(169)
	end)

	testing.test("Unit normalizes and preserves direction", function()
		local v = Vector3.new(10, 0, 0):Unit()
		expectVecNear(v, 1, 0, 0)
	end)

	testing.test("Unit of zero vector is zero vector", function()
		local v = Vector3.zero:Unit()
		expectVecNear(v, 0, 0, 0)
	end)

	testing.test("Dot product", function()
		local a = Vector3.new(1, 2, 3)
		local b = Vector3.new(4, -5, 6)
		expect(a:Dot(b)).toBe(12)
	end)

	testing.test("Cross orthogonality", function()
		local a = Vector3.new(1, 0, 0)
		local b = Vector3.new(0, 1, 0)
		local c = a:Cross(b)
		expect(c.X).toBe(0)
		expect(c.Y).toBe(0)
		expect(c.Z).toBe(1)
	end)

	testing.test("Arithmetic operators", function()
		local a = Vector3.new(1, 2, 3)
		local b = Vector3.new(4, 5, 6)
		expectVecNear(a + b, 5, 7, 9)
		expectVecNear(b - a, 3, 3, 3)
		expectVecNear(a * 2, 2, 4, 6)
		expectVecNear(2 * a, 2, 4, 6)
		expectVecNear(b / 2, 2, 2.5, 3)
		expectVecNear(-a, -1, -2, -3)
	end)

	testing.test("Distance and DistanceSquared", function()
		local a = Vector3.new(1, 2, 3)
		local b = Vector3.new(4, 6, 3)
		expect(a:Distance(b)).toBe(5)
		expect(a:DistanceSquared(b)).toBe(25)
	end)

	testing.test("Lerp midpoint", function()
		local a = Vector3.new(0, 0, 0)
		local b = Vector3.new(10, 20, -10)
		local v = a:Lerp(b, 0.5)
		expectVecNear(v, 5, 10, -5)
	end)

	testing.test("ClampMagnitude", function()
		local big = Vector3.new(3, 4, 0):ClampMagnitude(2)
		local small = Vector3.new(1, 1, 0):ClampMagnitude(10)
		expect(near(big:Magnitude(), 2)).toBeTruthy()
		expectVecNear(small, 1, 1, 0)
	end)

	testing.test("RotationMatrix + RotateByMatrix", function()
		local axis = Vector3.new(0, 0, 1)
		local m = Vector3.RotationMatrix(axis, math.pi / 2)
		local v = Vector3.new(1, 0, 0):RotateByMatrix(m)
		expectVecNear(v, 0, 1, 0)
	end)

	testing.test("RotateAroundAxis", function()
		local v = Vector3.new(1, 0, 0):RotateAroundAxis(Vector3.new(0, 0, 1), math.pi / 2)
		expectVecNear(v, 0, 1, 0)
	end)

	testing.test("Project", function()
		local v = Vector3.new(3, 4, 0):Project(Vector3.new(1, 0, 0))
		expectVecNear(v, 3, 0, 0)
	end)

	testing.test("Angle", function()
		local x = Vector3.new(1, 0, 0)
		local y = Vector3.new(0, 1, 0)
		expect(near(x:Angle(y), math.pi / 2)).toBeTruthy()
	end)

	testing.test("Reflect", function()
		local v = Vector3.new(1, -1, 0)
		local normal = Vector3.new(0, 1, 0)
		local r = v:Reflect(normal)
		expectVecNear(r, 1, 1, 0)
	end)

	testing.test("Round, Abs, Min, Max", function()
		local v = Vector3.new(-1.49, 2.5, -3.51)
		expectVecNear(v:Round(), -1, 3, -4)
		expectVecNear(v:Abs(), 1.49, 2.5, 3.51)
		expectVecNear(v:Min(Vector3.new(-2, 3, -4)), -2, 2.5, -4)
		expectVecNear(v:Max(Vector3.new(-2, 3, -4)), -1.49, 3, -3.51)
	end)

	testing.test("DirectionTo and DirectionToLength", function()
		local from = Vector3.new(1, 1, 1)
		local to = Vector3.new(4, 1, 1)
		expectVecNear(from:DirectionTo(to), 1, 0, 0)
		expectVecNear(from:DirectionToLength(to, 2), 2, 0, 0)
	end)

	testing.test("LookAt basis vectors", function()
		local basis = Vector3.new(0, 0, 0):LookAt(Vector3.new(0, 0, 1))
		expectVecNear(basis.forward, 0, 0, 1)
		expectVecNear(basis.right, 1, 0, 0)
		expectVecNear(basis.up, 0, 1, 0)
	end)

	testing.test("IsZero and Equals", function()
		local almostZero = Vector3.new(1e-6, -1e-6, 1e-6)
		expect(almostZero:IsZero()).toBeTruthy()
		expect(Vector3.new(1, 2, 3):Equals(Vector3.new(1.000001, 2.000001, 3.000001), 1e-3)).toBeTruthy()
	end)

	testing.test("Slerp halfway between orthogonal unit vectors", function()
		local a = Vector3.new(1, 0, 0)
		local b = Vector3.new(0, 1, 0)
		local c = Vector3.Slerp(a, b, 0.5)
		local s = math.sqrt(0.5)
		expectVecNear(c, s, s, 0)
	end)

	testing.test("ToTable and FromTable roundtrip", function()
		local a = Vector3.new(7, 8, 9)
		local tbl = a:ToTable()
		local b = Vector3.FromTable(tbl)
		expectVecNear(b, 7, 8, 9)
	end)

	testing.test("Constants", function()
		expectVecNear(Vector3.zero, 0, 0, 0)
		expectVecNear(Vector3.one, 1, 1, 1)
	end)

	testing.test("__sub asserts on bad input", function()
		local ok = pcall(function()
			return Vector3.new(1, 0, 0) - { notavector = true }
		end)
		expect(ok).toBeFalsy()
	end)

	testing.test("__div errors on non-scalar divisor", function()
		local ok = pcall(function()
			return Vector3.new(1, 2, 3) / Vector3.new(1, 1, 1)
		end)
		expect(ok).toBeFalsy()
	end)
end)
